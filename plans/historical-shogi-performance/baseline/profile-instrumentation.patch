@@ -0,0 +1,7 @@
+use std::{cell::RefCell,time::Instant};
+thread_local! {static COUNTS:RefCell<([u64;9],[u128;9])>=const {RefCell::new(([0;9],[0;9]))};}
+pub struct Span(usize,Instant);
+pub fn span(id:usize)->Span {Span(id,Instant::now())}
+impl Drop for Span {fn drop(&mut self){let elapsed=self.1.elapsed().as_nanos();COUNTS.with(|c|{let mut c=c.borrow_mut();c.0[self.0]+=1;c.1[self.0]+=elapsed;});}}
+pub fn reset(){COUNTS.with(|c|*c.borrow_mut()=([0;9],[0;9]));}
+pub fn report()->([u64;9],[u128;9]){COUNTS.with(|c|*c.borrow())}
