  "implementation": {
    "internalKey": "Fixed deterministic generated Zobrist tokens, no square-by-piece lookup table. Rule/geometry domain, internal PieceId (including origin), color, square, side, senjishi and ordered shitenno.",
    "delta": "Apply old/final changed squares and old/new state/side once per completed move. Original square values survive repeated touches in Delta. Previous position/history keys retained alongside undo in timeline.",
    "history": "Ordered rolling key per timeline entry; TT key includes active pending prefix. Same board with different history/pending remains distinct.",
    "effects": "Active/frozen kings and resident fires derive from board and ordered state; no independent turn-start effect state survives a completed move.",
    "publicHashes": "Position FNV unchanged. Public context reconstructs original FNVs via undo only at inspect API boundary, then uses original fold and pending term.",
    "excluded": [
      "Effect caching",
      "Path reuse",
      "Board-copy reductions",
      "Rule changes",
      "Frontend rollout"
    ]
  },
