+
+fn scratch_game<R: ClassicalRule>() {
+    let p = Position::<R>::from_wire(&WirePosition {
+        side_to_move: 0,
+        pieces: R::initial(),
+        hands: Default::default(),
+        state: Default::default(),
+    })
+    .unwrap();
+    let mut game = ClassicalGame::<R>::root(p);
+    let mut seed = 0x5c4a7c01u32 + R::ID;
+    for _ in 0..128 {
+        let current = game.current();
+        let mut scratch = current.clone();
+        let moves = game.moves();
+        if moves.is_empty() {
+            break;
+        }
+        for &m in moves.iter().take(32) {
+            let result = scratch.classical_acceptable_in_place(m, &mut || false);
+            assert_eq!(result, current.classical_acceptable_copy(m, &mut || false));
+            assert_eq!(scratch, *current);
+            assert_eq!(scratch.classical_acceptable_in_place(m, &mut || true), None);
+            assert_eq!(scratch, *current);
+        }
+        seed ^= seed << 13;
+        seed ^= seed >> 17;
+        seed ^= seed << 5;
+        game.push(moves[seed as usize % moves.len()]);
+    }
+}
+#[test]
+fn no_hand_scratch_restores_all_fields_after_accept_reject_and_cancel() {
+    scratch_game::<Washogi>();
+    scratch_game::<HeianDai>();
+}
