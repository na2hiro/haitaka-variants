{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haitaka:tuyouraou11:reference-fixture:v1",
  "title": "TuyouraOu11 micro reference fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "arch",
    "model",
    "reference",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "arch": {
      "const": "SFNN_ka2_2048_8_64_progress8"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nnSha256",
        "progressSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nnSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "progressSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "command",
        "buildFlags",
        "fvScale",
        "generator"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "buildFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fvScale": {
          "const": 24
        },
        "generator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sfen",
          "tags",
          "progress",
          "evalCp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sfen": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sumsQ16",
              "selectedSumQ16",
              "bucket"
            ],
            "properties": {
              "sumsQ16": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)$"
                }
              },
              "selectedSumQ16": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)$"
              },
              "bucket": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            }
          },
          "evalCp": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        }
      }
    }
  }
}
